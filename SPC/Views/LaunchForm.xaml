<Window x:Class="SPC.Views.LaunchForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPC.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="#EADBD6"
        Title="LaunchForm" Height="300" Width="300">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

            <Label Content="UAP :" Grid.Row="0" Grid.Column="0" Margin="10 20 10 5" HorizontalContentAlignment="Right" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
            <TextBox Width="120" Grid.Row="0" Grid.Column="1" Text="{Binding UAP}" Margin="0 20 10 5"/>

            <Label Content="Operateur :" Grid.Row="1" Grid.Column="0" Margin="10 10 10 5" HorizontalContentAlignment="Right" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
            <TextBox Width="120" Grid.Row="1" Grid.Column="1" Text="{Binding Operateur}" Margin="0 10 10 5"/>

            <Label Content="N Operateur :" Grid.Row="2" Grid.Column="0" Margin="10 10 10 5" HorizontalContentAlignment="Right" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
            <TextBox Width="120" Grid.Row="2" Grid.Column="1" Text="{Binding NOperateur}" Margin="0 10 10 5"/>

            <Button Content="Terminer" FontWeight="Bold" Margin="20" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="5 3 5 3" Background="LightBlue" Command="{Binding TerminerCommand}"/>
    </Grid>
</Window>
