<Window x:Class="SPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPC"
        mc:Ignorable="d"
        WindowState="Maximized"
        Background="LightGray"
        Title="SPC Application" Height="450" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="4 4 0 0" Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Label FontWeight="DemiBold" Content="Matricule:" Margin="5 0 5 5" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
            <TextBox Text="{Binding NMatricule, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0 0 15 10" VerticalAlignment="Center" Padding="3" Grid.Row="1" Grid.Column="1"/>
            <Label Content="{Binding OperateurLabel}" Grid.Row="0" Grid.Column="0" Height="25" HorizontalAlignment="Center" Grid.ColumnSpan="2"/>

            <Label FontWeight="DemiBold" Content="Machine:" Margin="25 0 5 5" VerticalAlignment="Center" Grid.Row="1" Grid.Column="2"/>
            <TextBox Text="{Binding NMachine, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0 0 120 10" VerticalAlignment="Center" Padding="3" Grid.Row="1" Grid.Column="3"/>
            <Label Content="{Binding MachineLabel}" Grid.Row="0" Grid.Column="2" Height="25" FontWeight="bold" HorizontalAlignment="Center" Grid.ColumnSpan="2"/>

            <Button FontWeight="DemiBold" Background="LightBlue" Content="Nouvelle Serie" Padding="15 0 15 0" Command="{Binding NewSeriesCommand}" Margin="20 0 0 10" Grid.Row="1" Grid.Column="4"/>
            <Button FontWeight="DemiBold" Background="YellowGreen"  Padding="15 0 15 0" Content="Surveillance/Fin" Command="{Binding SurrFinCommand}" Margin="0 0 0 10" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="5"/>
            <Button FontWeight="DemiBold" Background="Gray"  Padding="15 0 15 0" Content="History" Command="{Binding HistoryCommand}" Margin="0 0 10 10" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="6"/>

        </Grid>

        <Border Grid.Column="0" Grid.ColumnSpan="2" Margin="10" Grid.Row="1" BorderThickness="1.5" BorderBrush="Black">
            <DataGrid IsReadOnly="True"  HeadersVisibility="Column" CanUserAddRows="False" ItemsSource="{Binding FiltredSeries}"  AutoGenerateColumns="False" Width="auto" SelectedValue="{Binding SerieSelected}">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#C9ADA7"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderBrush" Value="Black"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="2 0 2 0"/>
                    <Setter Property="BorderThickness" Value="1.2 1.2 1.2 1"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="#EADBD6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True" >
                            <Setter Property="Background" Value="#97A2A6" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding NoSerie}" Header="No Serie" Width="auto"/>
                <DataGridTextColumn Binding="{Binding NoMachine}" Header="Machine" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Client}" Header="Client" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Name}" Header="Nom-Prenom" Width="auto"/> 
                <DataGridTextColumn Binding="{Binding DateCreation}" Header="Date" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Nature}" Header="Nature" Width="auto"/>
                <DataGridTextColumn Binding="{Binding NoOutil}" Header="Outil" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Quantite}" Header="Quantite" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Connexion}" Header="Connexion" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Denudage}" Header="Denudage" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Section}" Header="Section" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Repere}" Header="Repere" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HA}" Header="Hauteur ame" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HI}" Header="Hauteur isolant" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction}" Header="Traction" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Marquage}" Header="Aspect Marquage" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HA1}" Header="Hauteur ame 1" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HA2}" Header="Hauteur ame 2" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HA3}" Header="Hauteur ame 3" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HI1}" Header="Hauteur isolant 1" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HI2}" Header="Hauteur isolant 2" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HI3}" Header="Hauteur isolant 3" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction1}" Header="Traction 1" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction2}" Header="Traction 2" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction3}" Header="Traction 3" Width="auto"/>
                <DataGridTextColumn Binding="{Binding AspectCnx}" Header="Aspect Connexion" Width="auto"/>
                <DataGridTextColumn Binding="{Binding NoOutilB}" Header="Outil" Width="auto"/>
                <DataGridTextColumn Binding="{Binding ConnexionB}" Header="Connexion" Width="auto"/>
                <DataGridTextColumn Binding="{Binding DenudageB}" Header="Denudage" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HA1B}" Header="Hauteur ame 1" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HA2B}" Header="Hauteur ame 2" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HA3B}" Header="Hauteur ame 3" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HI1B}" Header="Hauteur isolant 1" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HI2B}" Header="Hauteur isolant 2" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HI3B}" Header="Hauteur isolant 3" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction1B}" Header="Traction 1" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction2B}" Header="Traction 2" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction3B}" Header="Traction 3" Width="auto"/>
                <DataGridTextColumn Binding="{Binding AspectCnxB}" Header="Aspect Connexion" Width="auto"/>
                <DataGridTextColumn Binding="{Binding NoOutilC}" Header="Outil" Width="auto"/>
                <DataGridTextColumn Binding="{Binding ConnexionC}" Header="Connexion" Width="auto"/>
                <DataGridTextColumn Binding="{Binding DenudageC}" Header="Denudage" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HA1C}" Header="Hauteur ame 1" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HA2C}" Header="Hauteur ame 2" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HA3C}" Header="Hauteur ame 3" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HI1C}" Header="Hauteur isolant 1" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HI2C}" Header="Hauteur isolant 2" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HI3C}" Header="Hauteur isolant 3" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction1C}" Header="Traction 1" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction2C}" Header="Traction 2" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction3C}" Header="Traction 3" Width="auto"/>
                <DataGridTextColumn Binding="{Binding AspectCnxC}" Header="Aspect Connexion" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Denudage1}" Header="Denudage 1" Width="auto"/> 
                <DataGridTextColumn Binding="{Binding Denudage2}" Header="Denudage 1" Width="auto"/> 
                <DataGridTextColumn Binding="{Binding Denudage3}" Header="Denudage 1" Width="auto"/> 
<!--                <DataGridTextColumn Binding="{Binding}" Header="" Width="auto"/>  -->
            </DataGrid.Columns>
       </DataGrid>
        </Border>

    </Grid>
</Window>
