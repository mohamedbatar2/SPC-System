<Window x:Class="SPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPC"
        mc:Ignorable="d"
        WindowState="Maximized"
        Background="LightGray"
        Title="SPC Application" Height="450" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="4 4 0 0" Grid.Row="0" >

            <StackPanel Orientation="Horizontal" Margin="5" Background="LightSlateGray">
                <Label FontWeight="DemiBold" Content="N Series:" Margin="5"/>
                <TextBox Width="80" Margin="0 5 10 5" Text="{Binding NSerie, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="3"/>
            </StackPanel>

            <Label FontWeight="DemiBold" Content="Matricule:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Text="{Binding NMatricule}" Width="120" Margin="0 10 15 10" VerticalAlignment="Center" Padding="3"/>
            <Label FontWeight="DemiBold" Content="Machine:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Text="{Binding NMachine}" Width="120" Margin="0 10 15 10" VerticalAlignment="Center" Padding="3"/>
            <Button FontWeight="DemiBold" Background="LightBlue" Content="Nouvelle Serie" Padding="5 0 5 0" Command="{Binding NewSeriesCommand}" Margin="20 5 0 5"/>
            <Button FontWeight="DemiBold" Background="YellowGreen"  Padding="5 0 5 0" Content="Surveillance/Fin" Command="{Binding SurrFinCommand}" Margin="0 5 5 5" HorizontalAlignment="Right"/>
        </StackPanel>

        <Border Grid.Column="0" Grid.ColumnSpan="2" Margin="10" Grid.Row="1" BorderThickness="1.5" BorderBrush="Black">
            <DataGrid IsReadOnly="True"  HeadersVisibility="Column" CanUserAddRows="False" ItemsSource="{Binding FiltredSeries}"  AutoGenerateColumns="False" Width="auto">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#C9ADA7"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderBrush" Value="Black"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="2 0 2 0"/>
                    <Setter Property="BorderThickness" Value="1.2 1.2 1.2 1"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="#EADBD6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True" >
                            <Setter Property="Background" Value="#97A2A6" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding NoSerie}" Header="No Serie" Width="auto"/>
                <DataGridTextColumn Binding="{Binding NoMachine}" Header="Machine" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Client}" Header="Client" Width="auto"/>
                <DataGridTextColumn Binding="{Binding OperationNo}" Header="matricule" Width="auto"/> <!--get the name of the operation-->
                <DataGridTextColumn Binding="{Binding DateCreation}" Header="Date" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Nature}" Header="Nature" Width="auto"/>
                <DataGridTextColumn Binding="{Binding NoOutil}" Header="Outil" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Quantite}" Header="Quantite" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Connexion}" Header="Connexion" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Denudage}" Header="Denudage" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Section}" Header="Section" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Repere}" Header="Repere" Width="auto"/>
                <DataGridTextColumn Binding="{Binding AH1}" Header="Hauteur sertissage 1" Width="auto"/>
                <DataGridTextColumn Binding="{Binding AH2}" Header="Hauteur sertissage 2" Width="auto"/>
                <DataGridTextColumn Binding="{Binding AH3}" Header="Hauteur sertissage 3" Width="auto"/>
                <DataGridTextColumn Binding="{Binding FH1}" Header="Hauteur fretage 1" Width="auto"/>
                <DataGridTextColumn Binding="{Binding FH2}" Header="Hauteur fretage 2" Width="auto"/>
                <DataGridTextColumn Binding="{Binding FH3}" Header="Hauteur fretage 3" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction1}" Header="Traction 1" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction2}" Header="Traction 2" Width="auto"/>
                <DataGridTextColumn Binding="{Binding Traction3}" Header="Traction 3" Width="auto"/>
<!--                <DataGridTextColumn Binding="{Binding}" Header="" Width="auto"/>  -->
            </DataGrid.Columns>
       </DataGrid>
       </Border>

    </Grid>
</Window>
