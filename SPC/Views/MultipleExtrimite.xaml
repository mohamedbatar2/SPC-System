<Window x:Class="SPC.Views.MultipleExtrimite"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPC.Views"
        mc:Ignorable="d"
        Title="Multiple Extrimite" Height="610" Width="800"
        Background="LightGray">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1" Margin="20 20 0 0" Grid.Column="0">
                <StackPanel >
                    <TextBlock FontWeight="Bold" TextAlignment="Center" Foreground="White" Text="CLIENT" Background="LightGreen" />
                    <TextBox Width="120" Height="25" />
                </StackPanel>
            </Border>
            <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1" Margin="0 20 0 0" Grid.Column="1">
                <StackPanel >
                    <TextBlock FontWeight="Bold" TextAlignment="Center" Foreground="White" Text="Ref Client" Background="LightGreen" />
                    <TextBox Width="120" Height="25" />
                </StackPanel>
            </Border>
            <Border  Grid.Row="0" BorderBrush="Black" BorderThickness="1" Margin="0 20 0 0" Grid.Column="2">
                <StackPanel >
                    <TextBlock TextAlignment="Center" FontWeight="Bold" Foreground="White" Text="REPERE" Background="LightGreen" />
                    <TextBox Width="120" Height="25" />
                </StackPanel>
            </Border>
            <Border  Grid.Row="0" BorderBrush="Black" BorderThickness="1" Margin="0 20 0 0" Grid.Column="3">
                <StackPanel >
                    <TextBlock TextAlignment="Center" FontWeight="Bold" Foreground="White" Text="SECTION FIL" Background="LightGreen" />
                    <TextBox Width="130" Height="25" />
                </StackPanel>
            </Border>
            <Border Grid.Row="0"  BorderBrush="Black" BorderThickness="1" Margin="0 20 0 0" Grid.Column="4">
                <StackPanel >
                    <TextBlock TextAlignment="Center" Foreground="White" FontWeight="Bold" Text="NATURE CONTROLE" Background="LightGreen" />
                    <ComboBox Width="130" Height="25" Grid.Row="1" >
                        <ComboBoxItem Content="B"/>
                        <ComboBoxItem Content="B-F"/>
                        <ComboBoxItem Content="F"/>
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border  Grid.Row="0"  BorderBrush="Black" BorderThickness="1" Margin="0 20 0 0" Grid.Column="6">
                <StackPanel >
                    <TextBlock TextAlignment="Center" Foreground="White" Text="QUANTITE" FontWeight="Bold" Background="LightGreen" />
                    <TextBox Width="120" Height="25" />
                </StackPanel>
            </Border>
            <Border  Grid.Row="1"  BorderBrush="Black" BorderThickness="1" Margin="0 0 0 20" Grid.Column="1">
                <StackPanel >
                    <TextBlock TextAlignment="Center" Foreground="White" Text="LG Demande" FontWeight="Bold" Background="LightGreen" />
                    <TextBox Width="120" Height="25" />
                </StackPanel>
            </Border>
            <Border  Grid.Row="1"  BorderBrush="Black" BorderThickness="1" Margin="0 0 0 20" Grid.Column="2">
                <StackPanel >
                    <TextBlock TextAlignment="Center" Foreground="White" Text="LG Mesure" FontWeight="Bold" Background="LightGreen" />
                    <TextBox Width="120" Height="25" />
                </StackPanel>
            </Border>
            <Border  Grid.Row="1"  BorderBrush="Black" BorderThickness="1" Margin="0 0 0 20" Grid.Column="3">
                <StackPanel >
                    <TextBlock TextAlignment="Center" Foreground="White" Text="ASPECT MARQUAGE" FontWeight="Bold" Background="LightGreen" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="C" Margin="5 5 5 0"/>
                        <RadioButton Content="NC" Margin="5 5 5 0"/>
                        <RadioButton Content="NA" Margin="5 5 5 0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border  Grid.Row="1"  BorderBrush="Black" BorderThickness="1" Margin="0 0 0 20" Grid.Column="4">
                <StackPanel >
                    <TextBlock TextAlignment="Center" Foreground="White" Text="CLAQUAGE" FontWeight="Bold" Background="LightGreen" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="C" Margin="5 5 5 0"/>
                        <RadioButton Content="NC" Margin="5 5 5 0"/>
                        <RadioButton Content="NA" Margin="5 5 5 0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Label Content="EXTRIMITE A" HorizontalAlignment="Center" FontWeight="Bold" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>
            <Grid Grid.Row="1" Grid.Column="0" Margin="0 25 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="0">
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock FontWeight="Bold" Padding="10 0 10 0"  Background="black" Foreground="white" Text="HA" Width="90"/>
                        <TextBox Width="90"/>
                        <TextBox Width="90" Margin="5 0 5 0 "/>
                        <TextBox Width="90"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="1">
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock  FontWeight="Bold" Padding="10 0 10 0"  Background="black" Foreground="white" Text="FA" Width="90"/>
                        <TextBox Width="90"/>
                        <TextBox Width="90" Margin="5 0 5 0 "/>
                        <TextBox Width="90"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="2">
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock FontWeight="Bold"  Padding="10 0 10 0" Background="black" Foreground="white" Text="TRACTION" Width="90"/>
                        <TextBox Width="90"/>
                        <TextBox Width="90" Margin="5 0 5 0 "/>
                        <TextBox Width="90"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" Margin="10 0 20 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1"  Grid.Column="0">
                    <StackPanel >
                        <TextBlock FontWeight="Bold"  Background="black" Foreground="White" Text="Connexion" Width="90" TextAlignment="Center" />
                        <TextBox Width="90" Height="25"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Grid.Column="0">
                    <StackPanel >
                        <TextBlock FontWeight="Bold"  Background="black" Foreground="White" Text="N OUTIL" Width="90" TextAlignment="Center" />
                        <TextBox Width="90" Height="25"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1"  Grid.Column="1">
                    <StackPanel>
                        <TextBlock FontWeight="Bold"  Background="black" Foreground="White" Text="DENUDAGE" Width="90" TextAlignment="Center" />
                        <TextBox Width="90" Height="25"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1"  Grid.Column="1" Grid.Row="1">
                    <StackPanel>
                        <TextBlock FontWeight="Bold"  Background="black" Foreground="White" Text="ASPECT CNX" Width="90" TextAlignment="Center" />
                        <Border Background="White" Height="25" BorderThickness="1" BorderBrush="Gray">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="C" Margin="5 0 5 0"/>
                                <RadioButton Content="NC"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock Text="C:Conform NC:Non Conform" Foreground="Blue" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Label Content="EXTRIMITE B" HorizontalAlignment="Center" FontWeight="Bold" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>
            <Grid Grid.Row="1" Grid.Column="0" Margin="0 25 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="0">
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock FontWeight="Bold" Padding="10 0 10 0"  Background="black" Foreground="white" Text="HA" Width="90"/>
                        <TextBox Width="90"/>
                        <TextBox Width="90" Margin="5 0 5 0 "/>
                        <TextBox Width="90"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="1">
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock  FontWeight="Bold" Padding="10 0 10 0"  Background="black" Foreground="white" Text="FA" Width="90"/>
                        <TextBox Width="90"/>
                        <TextBox Width="90" Margin="5 0 5 0 "/>
                        <TextBox Width="90"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="2">
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock FontWeight="Bold"  Padding="10 0 10 0" Background="black" Foreground="white" Text="TRACTION" Width="90"/>
                        <TextBox Width="90"/>
                        <TextBox Width="90" Margin="5 0 5 0 "/>
                        <TextBox Width="90"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" Margin="10 0 20 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1"  Grid.Column="0">
                    <StackPanel >
                        <TextBlock FontWeight="Bold"  Background="black" Foreground="White" Text="Connexion" Width="90" TextAlignment="Center" />
                        <TextBox Width="90" Height="25"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Grid.Column="0">
                    <StackPanel >
                        <TextBlock FontWeight="Bold"  Background="black" Foreground="White" Text="N OUTIL" Width="90" TextAlignment="Center" />
                        <TextBox Width="90" Height="25"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1"  Grid.Column="1">
                    <StackPanel>
                        <TextBlock FontWeight="Bold"  Background="black" Foreground="White" Text="DENUDAGE" Width="90" TextAlignment="Center" />
                        <TextBox Width="90" Height="25"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1"  Grid.Column="1" Grid.Row="1">
                    <StackPanel>
                        <TextBlock FontWeight="Bold"  Background="black" Foreground="White" Text="ASPECT CNX" Width="90" TextAlignment="Center" />
                        <Border Background="White" Height="25" BorderThickness="1" BorderBrush="Gray">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="C" Margin="5 0 5 0"/>
                                <RadioButton Content="NC"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock Text="C:Conform NC:Non Conform" Foreground="Blue" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Label Content="EXTRIMITE C -Double-" Foreground="DarkGray" HorizontalAlignment="Center" FontWeight="Bold" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>
            <Grid Grid.Row="1" Grid.Column="0" Margin="0 25 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="0">
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock FontWeight="Bold" Padding="10 0 10 0"  Background="DarkGray" Foreground="white" Text="HA" Width="90"/>
                        <TextBox Width="90"/>
                        <TextBox Width="90" Margin="5 0 5 0 "/>
                        <TextBox Width="90"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="1">
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock  FontWeight="Bold" Padding="10 0 10 0"  Background="DarkGray" Foreground="white" Text="FA" Width="90"/>
                        <TextBox Width="90"/>
                        <TextBox Width="90" Margin="5 0 5 0 "/>
                        <TextBox Width="90"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1"  Grid.Row="2">
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock FontWeight="Bold"  Padding="10 0 10 0" Background="DarkGray" Foreground="white" Text="TRACTION" Width="90"/>
                        <TextBox Width="90"/>
                        <TextBox Width="90" Margin="5 0 5 0 "/>
                        <TextBox Width="90"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" Margin="10 0 20 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1"  Grid.Column="0">
                    <StackPanel >
                        <TextBlock FontWeight="Bold"  Background="DarkGray" Foreground="White" Text="Connexion" Width="90" TextAlignment="Center" />
                        <TextBox Width="90" Height="25"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Grid.Column="0">
                    <StackPanel >
                        <TextBlock FontWeight="Bold"  Background="DarkGray" Foreground="White" Text="N OUTIL" Width="90" TextAlignment="Center" />
                        <TextBox Width="90" Height="25"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1"  Grid.Column="1">
                    <StackPanel>
                        <TextBlock FontWeight="Bold"  Background="DarkGray" Foreground="White" Text="DENUDAGE" Width="90" TextAlignment="Center" />
                        <TextBox Width="90" Height="25"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1"  Grid.Column="1" Grid.Row="1">
                    <StackPanel>
                        <TextBlock FontWeight="Bold"  Background="DarkGray" Foreground="White" Text="ASPECT CNX" Width="90" TextAlignment="Center" />
                        <Border Background="White" Height="25" BorderThickness="1" BorderBrush="Gray">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="C" Margin="5 0 5 0"/>
                                <RadioButton Content="NC"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock Text="C:Conform NC:Non Conform" Foreground="Blue" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>

        <Button Grid.Row="4" Margin="20" VerticalAlignment="Bottom" HorizontalAlignment="right" Width="30" Height="20" Background="DimGray" Content="💾"/>
    </Grid>
</Window>
