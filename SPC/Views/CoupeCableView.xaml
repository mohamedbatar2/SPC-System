<Window x:Class="SPC.Views.CoupeCableView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SPC.Views"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="{Binding Name}" Height="450" Width="1000"
        Background="LightGray">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0 0 0 0" HorizontalAlignment="Center" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="20 20 0 0" Grid.Column="0">
                <Border BorderBrush="Black" BorderThickness="1" >
                    <StackPanel >
                        <TextBlock FontWeight="Bold" TextAlignment="Center" Foreground="White" Text="CLIENT" Background="LightGreen" />
                        <ComboBox Width="120" Height="25" ItemsSource="{Binding Clients}" Text="{Binding enreg.Client}"  /> <!--add is editable so when adding new clients it adds them to the databse-->
                    </StackPanel>
               </Border>
             </StackPanel>
            <StackPanel Margin="0 20 0 0" Grid.Column="1">
                <Border  BorderBrush="Black" BorderThickness="1" >
                <StackPanel >
                    <TextBlock FontWeight="Bold" TextAlignment="Center" Foreground="{Binding RefFor}" Text="Ref Client" Background="{Binding RefColor}" />
                    <TextBox Width="120" Height="25" Text="{Binding enreg.Ref}" IsReadOnly="{Binding EnregReadOnlyProp}"/>
                </StackPanel>
                </Border>
                <TextBlock Text="ref > 6 svp" Visibility="{Binding VisiRefWarning}" Foreground="red" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
            </StackPanel>
            <Border BorderBrush="Black" BorderThickness="1" Margin="0 20 0 20" Grid.Column="2">
                <StackPanel >
                    <TextBlock TextAlignment="Center" FontWeight="Bold" Foreground="White" Text="REPERE" Background="LightGreen" />
                    <TextBox Width="120" Height="25" Text="{Binding enregDetail.Repere}"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1" Margin="0 20 0 20" Grid.Column="3">
                <StackPanel >
                    <TextBlock TextAlignment="Center" FontWeight="Bold" Foreground="White" Text="SECTION FIL" Background="LightGreen" />
                    <TextBox Width="120" Height="25"  Text="{Binding Section, UpdateSourceTrigger=PropertyChanged,TargetNullValue=''}" IsReadOnly="{Binding EnregReadOnlyProp}" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>
            <StackPanel  Margin="0 20 0 0" Grid.Column="4">
                <Border BorderBrush="Black" BorderThickness="1">
                    <StackPanel >
                        <TextBlock TextAlignment="Center" Foreground="White" FontWeight="Bold" Text="NATURE CONTROLE" Background="LightGreen" />
                        <ComboBox ItemsSource="{Binding ItemsSourceD}" SelectedValue="{Binding Nature}" Width="120" Height="25" Grid.Row="1"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding NatureLabel}" Foreground="Black" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
            </StackPanel>
            <Border BorderBrush="Black" BorderThickness="1" Margin="0 20 20 20" Grid.Column="6">
                <StackPanel >
                    <TextBlock TextAlignment="Center" Foreground="White" Text="QUANTITE" FontWeight="Bold" Background="LightGreen" />
                    <TextBox Width="120" Height="25"  Text="{Binding Quantite,UpdateSourceTrigger=PropertyChanged,TargetNullValue=''}" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" HorizontalAlignment="Center" Margin="50" Visibility="{Binding ASPECTVISI}">
            <StackPanel >
                <TextBlock TextAlignment="Center" FontWeight="Bold" Foreground="White" Text="ASPECT MARQUAGE" Background="DarkSlateGray" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="CONFORM" IsChecked="{Binding CChicked}" Margin="10 2 10 2" />
                    <RadioButton Content="NON CONFORM" IsChecked="{Binding NCChicked}" Margin="0 2 0 2" />
                    <RadioButton Content="NON APPLIQUE" IsChecked="{Binding NAChicked}" Margin="10 2 10 2"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0 0 0 5">

            <Border BorderBrush="Black" BorderThickness="1" Margin="20 0 20 0">
                <StackPanel >
                    <TextBlock TextAlignment="Center" FontWeight="Bold" Foreground="White" Text="DENUDAGE-DEGAINAGE : 1" Background="DarkSlateGray" />
                    <TextBox Width="180" Height="25" Text="{Binding Denudage1, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="Black" BorderThickness="1" Margin="20 0 20 0">
                <StackPanel >
                    <TextBlock TextAlignment="Center" FontWeight="Bold" Foreground="White" Text="LG DEMANDE" Background="DarkSlateGray" />
                    <TextBox Width="150" Height="25" Text="{Binding LongueurD, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" IsReadOnly="{Binding EnregReadOnlyProp}"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="Black" BorderThickness="1" Margin="20 0 20 0">
                <StackPanel >
                    <TextBlock TextAlignment="Center" FontWeight="Bold" Foreground="White" Text="DENUDAGE-DEGAINAGE : 2" Background="DarkSlateGray" />
                    <TextBox Width="180" Height="25" Text="{Binding Denudage2, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
        
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="3" HorizontalAlignment="Center">
            <StackPanel >
                <TextBlock TextAlignment="Center" FontWeight="Bold" Foreground="White" Text="LG MESURE" Background="DarkSlateGray" />
                <TextBox Width="150" Height="25" Text="{Binding LongueurM, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Border>
        
        
        <Button Command="{Binding SaveCommand}" Grid.Row="4" Margin="0 0 20 20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="30" Height="20" Background="LightBlue" Content="💾"/>
    </Grid>
</Window>
